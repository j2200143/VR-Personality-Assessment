  beforeTaskMessages:
  - "\u5730\u4E0B\u65BD\u8A2D\u306B\u8A2A\u308C\u305F\u3068\u3053\u308D\u3001\u6B21\u306E\u90E8\u5C4B\u306B\u9032\u3080\u305F\u3081\u306E\u6249\u304C\u9589\u3058\u3066\u3044\u307E\u3057\u305F"
  - "\u3053\u306E\u6249\u3092\u958B\u304F\u306B\u306F\u3001\u9B54\u529B\u3092\u5145\u586B\u3057\u306A\u3051\u308C\u3070\u306A\u308A\u307E\u305B\u3093"
  - "\u6249\u306E\u6A2A\u306B\u3042\u308B\u8D77\u52D5\u30B9\u30A4\u30C3\u30C1\u3092\u62BC\u305B\u3070\u3001\u5145\u586B\u304C\u59CB\u307E\u308A\u6249\u306F\u958B\u304D\u307E\u3059"
  - "\u305F\u3060\u3057\u3001\u9B54\u529B\u306E\u5145\u586B\u304C\u4E0D\u5341\u5206\u3060\u3068\u3001\u4E8C\u5EA6\u3068\u958B\u304B\u306A\u304F\u306A\u308B\u6050\u308C\u304C\u3042\u308A\u307E\u3059"
  - "\u90E8\u5C4B\u306E\u56DB\u9685\u306B4\u3064\u306E\u88DC\u52A9\u9B54\u529B\u8D77\u52D5\u30B9\u30A4\u30C3\u30C1\u304C\u3042\u308A\u307E\u3059"
  - "\u3053\u308C\u3089\u3092\u3059\u3079\u3066\u30C1\u30A7\u30C3\u30AF\u3057\u3066\u56DE\u308C\u3070\u3001\u5B89\u5168\u304B\u3064\u78BA\u5B9F\u306B\u6249\u3092\u958B\u304F\u3053\u3068\u304C\u3067\u304D\u308B\u3067\u3057\u3087\u3046"
  - "\u2026\u307E\u3042\u3001\u9762\u5012\u306A\u3089\u3044\u304D\u306A\u308A\u30B9\u30A4\u30C3\u30C1\u3092\u62BC\u3057\u3066\u3082\u69CB\u3044\u307E\u305B\u3093\u304C\u3001\u6E96\u5099\u306F\u4E07\u5168\u306B\u3057\u3066\u304A\u304F\u3053\u3068\u3092\u304A\u52E7\u3081\u3057\u307E\u3059\u3088"
