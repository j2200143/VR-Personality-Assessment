  btnAMessage: "\u78BA\u5B9F\u306A\u5831\u916C\uFF0850\u30B4\u30FC\u30EB\u30C9\uFF09"
  btnASubMessage: "\u203B\u4ECA\u3059\u3050\u53D7\u3051\u53D6\u308C\u308B"
  btnBMessage: "\u6211\u6162\u306E\u5831\u916C\uFF08150\u30B4\u30FC\u30EB\u30C9\uFF09"
  btnBSubMessage: "\u203B\u53D7\u3051\u53D6\u308B\u306B\u306F\u3001\u3053\u306E\u90E8\u5C4B\u30671\u5206\u9593\u5F85\u6A5F\u3059\u308B\u5FC5\u8981\u304C\u3042\u308B"
  choiceAMessage:
  - "\u304B\u3057\u3053\u307E\u308A\u307E\u3057\u305F\u3001\u5831\u916C\u306E50\u30B4\u30FC\u30EB\u30C9\u3092\u3042\u306A\u305F\u306E\u304A\u8CA1\u5E03\u306B\u5165\u308C\u3066\u304A\u304D\u307E\u3057\u305F"
  - "\u30B3\u30F3\u30C6\u30CA\u306E\u4ED5\u5206\u3051\u304A\u75B2\u308C\u69D8\u3067\u3057\u305F"
  choiceBMessage:
  - "\u3088\u308D\u3057\u3044\u3002\u3067\u306F\u3001\u79C1\u304C\u623B\u308B\u307E\u3067\u306E1\u5206\u9593\u3001\u3053\u306E\u90E8\u5C4B\u3067\u5F85\u3063\u3066\u3044\u3066\u304F\u3060\u3055\u3044"
  - "\u305F\u3060\u3057\u3001\u90E8\u5C4B\u306E\u4E2D\u592E\u306B\u3042\u308B\u300E\u30DC\u30BF\u30F3\u300F\u306B\u306F\u6C7A\u3057\u3066\u89E6\u308C\u306A\u3044\u3067\u304F\u3060\u3055\u3044"
  - "\u3082\u3057\u4E00\u5EA6\u3067\u3082\u89E6\u308C\u3066\u3057\u307E\u3063\u305F\u3089\u3001\u5831\u916C\u306F\u30BC\u30ED\u306B\u306A\u308A\u307E\u3059"
