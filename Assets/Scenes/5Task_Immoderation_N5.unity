  - "\u7D04\u675F\u901A\u308A\u5831\u916C\u306E150\u30B4\u30FC\u30EB\u30C9\u3092\u3042\u306A\u305F\u306E\u304A\u8CA1\u5E03\u306B\u5165\u308C\u3066\u304A\u304D\u307E\u3057\u305F"
  - "\u30B3\u30F3\u30C6\u30CA\u306E\u4ED5\u5206\u3051\u304A\u75B2\u308C\u69D8\u3067\u3057\u305F"
