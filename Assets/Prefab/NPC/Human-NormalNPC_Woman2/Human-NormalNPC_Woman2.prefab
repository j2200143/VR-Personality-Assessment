  dialogueLines:
  - "\u3042\u3042\u3001\u3069\u3046\u3057\u3088\u3046"
  - "\u3042\u3001\u3053\u3093\u306B\u3061\u306F"
  - "\u5B50\u4F9B\u304C\u75C5\u6C17\u3067\u2026\u3002\u85AC\u3092\u5C4A\u3051\u3066\u3084\u308A\u305F\u3044\u306E\u3067\u3059\u304C\u3001"
  - "\u79C1\u306F\u5E83\u5834\u3067\u30E9\u30A4\u30BB\u30F3\u30B9\u3092\u843D\u3068\u3057\u3066\u3057\u307E\u3044\u305D\u308C\u3092\u63A2\u3055\u306D\u3070\u3044\u3051\u306A\u304F\u3066\u2026"
