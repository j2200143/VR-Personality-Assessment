  dialogueLines:
  - "\u3084\u3042\u3001\u4F55\u304B\u7528\u304B\u3044\uFF1F"
  - "\u7528\u304C\u306A\u3044\u306A\u3089\u3055\u3001\u983C\u307F\u304C\u3042\u308B\u3093\u3060\u304C\u3001\u3001"
  - "\u304A\u8179\u304C\u7A7A\u3044\u305F\u3093\u3060\u2026\u3002\u5C11\u3057\u3067\u3044\u3044\u304B\u3089\u3001\u6075\u3093\u3067\u3082\u3089\u3048\u306A\u3044\u304B\u2026"
  - "\u307B\u3093\u3068\u306B\u3061\u3087\u3063\u3068\u306E\u30B4\u30FC\u30EB\u30C9\u3067\u3044\u3044\u3093\u3060"
